# PLANIX — CLIENT PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Server Port & Environment
PORT=3000
NODE_ENV=production

# Multi-AI Engine API Keys (Optional - System defaults to offline NLP fallback)
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Client Application Metadata
APP_NAME=Planix Personal OS
STORAGE_PATH=./data
